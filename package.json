{
  "name": "@rushdb/agent-memory-contract",
  "version": "0.3.0",
  "description": "Provider-neutral RushDB agent-memory event contract and client primitives",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/agent-memory-event.v1.schema.json",
    "./fixtures": "./fixtures/conformance.v1.json"
  },
  "files": [
    "README.md",
    "dist",
    "schema",
    "fixtures"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "pack:check": "node scripts/verify-package.mjs",
    "prepack": "pnpm build",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "@rushdb/javascript-sdk": "^3.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^20.17.23",
    "rimraf": "^6.0.1",
    "typescript": "5.7.2",
    "vitest": "^1.6.1"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "rushdb",
    "agent memory",
    "agent-memory",
    "memory contract",
    "event contract",
    "conformance",
    "json schema",
    "openclaw",
    "hermes",
    "ai agents",
    "ai-agents",
    "llm memory",
    "llm-memory",
    "semantic recall",
    "knowledge graph",
    "knowledge-graph"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rush-db/agent-memory-contract.git"
  },
  "bugs": "https://github.com/rush-db/agent-memory-contract/issues",
  "homepage": "https://github.com/rush-db/agent-memory-contract#readme",
  "packageManager": "pnpm@10.1.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  }
}
